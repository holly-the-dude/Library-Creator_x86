#!/usr/bin/env bash
# Debian PC/VM installer. Menu and USB workflow adapted from bootstrap_pi.
set -euo pipefail

SOURCE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

# Keep the Pi bootstrap palette, including worker output captured for Firefox.
RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' CYAN='' WHITE='' BOLD='' NC=''
if [[ ( -t 1 || -t 0 ) && "${TERM:-dumb}" != dumb && -z "${NO_COLOR:-}" ]]; then
    RED=$'\033[0;31m' GREEN=$'\033[0;32m' YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m' MAGENTA=$'\033[0;35m' CYAN=$'\033[0;36m'
    WHITE=$'\033[1;37m' BOLD=$'\033[1m' NC=$'\033[0m'
fi

usage() {
    cat <<'EOF'
Library installer — Debian Trixie amd64 / arm64
  sudo ./bootstrap                       Interactive menu
  sudo ./bootstrap --install [options]   Fresh install / retry
  sudo ./bootstrap --rebuild [options]   Rebuild images and refresh services
  sudo ./bootstrap --reinstall           Git pull --ff-only, then rebuild
  sudo ./bootstrap --configure-office [yes|no]
  sudo ./bootstrap --install-clone       Repair USB-content Clone support
  sudo ./bootstrap --format-usb --usb-device /dev/sdb1
  sudo ./bootstrap --status
  ./bootstrap --check

Options: --usb-device PARTITION, --storage directory|mounted, --office yes|no,
         --hotspot-interface DEVICE --hotspot-password PASSWORD, --yes
--yes skips the installation summary confirmation, NEVER erase confirmation.
USB formatting always requires the exact device name and a 30-second countdown.
Firefox opens file:///root/progress.html on the local
logged-in desktop. That page refreshes every 15 seconds, including the final
result. Full output is saved in /var/log/library-installer/install.log.
EOF
}

preflight() {
    local ID='' VERSION_CODENAME='' architecture
    . /etc/os-release
    if [[ "$ID" != debian || "$VERSION_CODENAME" != trixie ]]; then
        echo 'This installer requires Debian 13 (trixie), amd64 or arm64.' >&2
        return 1
    fi
    . "$SOURCE_DIR/setup_library/files/containers/architecture.sh"
    architecture=$(library_native_arch) || return
    [[ "$(dpkg --print-architecture)" == "$architecture" ]] || {
        echo 'Install a native 64-bit Debian OS matching the hardware architecture.' >&2; return 1;
    }
    [[ -d /run/systemd/system ]] || { echo 'A booted systemd host is required.' >&2; return 1; }
    [[ -f "$SOURCE_DIR/setup_library/files/start_library.yml" ]] || return 1
    echo "Debian Trixie $architecture preflight passed."
}


msg_info() { printf '%s[INFO]%s %s\n' "$BLUE" "$NC" "$*"; }
msg_ok() { printf '%s[OK]%s %s\n' "$GREEN" "$NC" "$*"; }
msg_warn() { printf '%s[WARN]%s %s\n' "$YELLOW" "$NC" "$*"; }
msg_error() { printf '%s[FAIL]%s %s\n' "$RED" "$NC" "$*" >&2; }
msg_step() { printf '%s[STEP]%s %s%s%s\n' "$MAGENTA" "$NC" "$BOLD" "$*" "$NC"; }
confirm() {
    local answer
    read -r -p "${YELLOW}${1:-Continue?} [y/yes/N]: ${NC}" answer || return 1
    [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

banner() {
    printf '%s╔══════════════════════════════════════════════════╗%s\n' "$CYAN" "$NC"
    printf '%s║%s       Library Bootstrap Installer                %s║%s\n' "$CYAN" "$WHITE" "$CYAN" "$NC"
    printf '%s║%s       Debian Trixie AMD64 / ARM64                 %s║%s\n' "$CYAN" "$YELLOW" "$CYAN" "$NC"
    printf '%s╚══════════════════════════════════════════════════╝%s\n' "$CYAN" "$NC"
}

separator() { printf '%s──────────────────────────────────────────────────%s\n' "$CYAN" "$NC"; }

pause_menu() {
    if [[ -t 0 && -t 1 ]]; then
        read -r -p "${CYAN}Press Enter to return to the menu...${NC}" || return 0
    fi
}

show_main_menu() {
    if [[ -t 1 && "${TERM:-dumb}" != dumb ]]; then
        printf '\033[H\033[2J'
    fi
    banner
    printf '%s  Main Menu%s\n' "$WHITE" "$NC"
    separator
    printf '  %s1)%s Fresh Install          - Select USB storage and Office tools\n' "$GREEN" "$NC"
    printf '  %s2)%s Reinstall / Upgrade    - Git pull, then rebuild containers\n' "$GREEN" "$NC"
    printf '  %s3)%s Restart Install        - Retry installation from this checkout\n' "$GREEN" "$NC"
    printf '  %s4)%s System Status          - Progress, services, containers and storage\n' "$GREEN" "$NC"
    printf '  %s5)%s Install / Repair Clone - Enable USB content cloning in Downloads\n' "$GREEN" "$NC"
    printf '  %s6)%s Configure Office       - Enable or disable without rebuilding\n' "$GREEN" "$NC"
    printf '  %s7)%s Rebuild Containers     - Rebuild from current source, refresh services\n' "$GREEN" "$NC"
    printf '  %s8)%s Format Library USB     - Select partition, confirm erase, countdown\n' "$GREEN" "$NC"
    printf '  %sq)%s Quit\n' "$RED" "$NC"
    separator
}

show_status() {
    msg_info "Checkout: $SOURCE_DIR"
    if [[ -f /root/library-install-state.json ]]; then cat /root/library-install-state.json; fi
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS
    systemctl --no-pager --full status start_library.service || true
    podman ps -a || true
    msg_info 'Full log: /var/log/library-installer/install.log'
    msg_info 'Progress: file:///root/progress.html'
}

prompt_office_addon() {
    msg_info 'Optional Office tools: WordCraft, DeckCraft and GridCraft.'
    msg_info 'Requires a keyboard AND a pointing device in the browser.'
    office=no
    if confirm 'Enable the Office tools?'; then office=yes; fi
}

prompt_storage() {
    local choice
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS
    printf '\n1) Library USB partition  2) Already mounted /Library  3) System disk directory\n'
    read -r -p 'Storage [1]: ' choice
    case "${choice:-1}" in
        1) read -r -p 'USB partition [/dev/sdb1]: ' usb; usb=${usb:-/dev/sdb1}; storage=mounted ;;
        2) storage=mounted; usb='' ;;
        3) storage=directory; usb='' ;;
        *) msg_error 'Unknown storage choice.'; return 1 ;;
    esac
}

save_office_choice() {
    python3 - "$office" <<'PYOFFICE'
import json, os, sys
from pathlib import Path
p = Path('/etc/library/config.json')
data = json.loads(p.read_text())
data['library_office'] = sys.argv[1]
tmp = p.with_suffix('.tmp')
tmp.write_text(json.dumps(data, indent=2) + '\n')
os.replace(tmp, p)
PYOFFICE
}

configure_office_addon() {
    local storage_mode status
    [[ -f /etc/library/config.json && -f /root/start_library.yml ]] || {
        msg_error 'Complete the Library install first.'; return 1;
    }
    if [[ -z "$office" ]]; then prompt_office_addon; fi
    if [[ "$office" == yes ]]; then
        storage_mode=$(python3 -c 'import json; print(json.load(open("/etc/library/config.json"))["library_storage_mode"])')
        if [[ "$storage_mode" == mounted ]]; then
            mountpoint -q /Library || { msg_error 'Mount the Library USB before enabling Office.'; return 1; }
        fi
    fi
    if [[ "$yes" != yes ]]; then
        msg_warn 'Save open Office documents before applying this change.'
        confirm "Apply Office setting ($office)?" || return 0
    fi
    msg_step "Setting Office to $office"
    bash "$SOURCE_DIR/setup_library/files/containers/craft_apps/set-enabled.sh" "$office"
    save_office_choice
    ansible-playbook -i localhost, -c local /root/start_library.yml --tags craft_apps
    if [[ "$office" == yes ]]; then
        [[ "$(podman inspect --format '{{.State.Running}}' craft_apps)" == true ]] || {
            msg_error 'Office failed to start. Check podman logs craft_apps.'; return 1;
        }
    fi
    # The frontend rebuilds its navigation when restarted; no image rebuild.
    if podman container exists webserver; then
        podman restart webserver
    else
        status=$?
        [[ $status == 1 ]] || return "$status"
    fi
    msg_info 'Office preference saved. Documents and settings were retained.'
}

check_clone_setup_idle() {
    local downloader_running
    downloader_running=$(podman inspect --format '{{.State.Running}}' data_download 2>/dev/null) || downloader_running=false
    python3 - "$downloader_running" <<'PYCLONE'
import json
import os
import socket
import sys
import urllib.request

try:
    path = '/run/library-clone/clone.sock'
    if os.path.exists(path):
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(15)
            client.connect(path)
            client.sendall(b'{"action":"status"}\n')
            with client.makefile('rb') as stream:
                response = json.loads(stream.readline(65536))
        if not response.get('ok') or response['result']['status'] not in {'idle', 'complete', 'failed'}:
            raise ValueError('Wait for the active clone to finish before updating its service.')
    if sys.argv[1] == 'true':
        with urllib.request.urlopen('http://127.0.0.1:4826/api/state', timeout=15) as response:
            state = json.load(response)
        if (state.get('upload_active') or state.get('refreshing')
                or state.get('restart', {}).get('requested')
                or state.get('clone', {}).get('status') in {'running', 'unknown'}
                or any(job['status'] in {'queued', 'downloading', 'verifying', 'extracting'}
                       for job in state['jobs'])):
            raise ValueError('Wait for transfers, source refresh, cloning or restart to finish.')
except Exception as exc:
    print(f'Cannot safely update Clone: {exc}', file=sys.stderr)
    sys.exit(1)
PYCLONE
}

install_clone_service() {
    local repository="$SOURCE_DIR" ansible file
    ansible=/usr/bin/ansible-playbook
    if [[ ! -x "$ansible" ]]; then
        ansible=$(command -v ansible-playbook) || {
            msg_error "Ansible is not installed. Complete the Library installation first."
            return 1
        }
    fi
    for file in setup_library/install_clone.yml \
                setup_library/files/start_library.yml \
                setup_library/files/library-clone.socket \
                setup_library/files/library-clone.service \
                setup_library/files/containers/data_download/clone_host.py; do
        if [[ ! -f "$repository/$file" ]]; then
            msg_error "Missing $repository/$file. Use the complete updated source folder."
            return 1
        fi
    done
    if ! podman image exists localhost/data_download:latest; then
        msg_error "Install the updated data_download image first, then run this option again."
        return 1
    fi
    if ! mountpoint -q /Library; then
        msg_error "Mount the Library_USB drive at /Library before enabling Clone."
        return 1
    fi
    check_clone_setup_idle || return 1
    msg_step "Installing the host clone service and dependencies..."
    "$ansible" "$repository/setup_library/install_clone.yml" \
        --tags clone_service -i localhost, -c local || return 1

    # Installing packages can take time. Do not interrupt work admitted since
    # the first check, and do not restart a helper in the middle of a clone.
    check_clone_setup_idle || return 1
    systemctl try-restart library-clone.service || return 1
    systemctl is-active --quiet library-clone.socket || return 1
    install -m 0755 "$repository/setup_library/files/start_library.yml" /root/start_library.yml || return 1

    msg_step "Recreating the downloader with access to the clone socket..."
    "$ansible" /root/start_library.yml --tags data_download -i localhost, -c local || return 1
    if ! podman exec data_download test -S /run/library-clone/clone.sock; then
        msg_error "The downloader cannot see the clone socket. Check the startup output."
        return 1
    fi
    msg_ok "Clone is enabled. Refresh Downloads and open Clone."
}


install_library() {
    if [[ -f /etc/library/config.json ]]; then
        if [[ -z "$storage$usb" ]]; then
            usb=$(python3 -c 'import json; print(json.load(open("/etc/library/config.json")).get("library_usb_device", ""))')
        fi
        [[ -n "$storage" ]] || storage=$(python3 -c 'import json; print(json.load(open("/etc/library/config.json"))["library_storage_mode"])')
        [[ -n "$office" ]] || office=$(python3 -c 'import json; print(json.load(open("/etc/library/config.json"))["library_office"])')
    fi
    if [[ -z "$storage" ]]; then
        if mountpoint -q /Library; then storage=mounted; else storage=directory; fi
    fi
    office=${office:-no}
    if [[ "$storage" == mounted && -z "$usb" ]]; then
        mountpoint -q /Library || { msg_error 'Mount your content disk at /Library first.'; return 1; }
    fi
    export DEBIAN_FRONTEND=noninteractive
    msg_step "Installing Debian packages"
    apt-get update
    apt-get install -y podman ansible python3-jmespath python3-flask rsync curl jq \
        ca-certificates util-linux exfatprogs udev firefox-esr git acl
    if [[ "${LIBRARY_PROGRESS_BROWSER_OPENED:-0}" != 1 ]]; then
        python3 "$SOURCE_DIR/setup_library/install_progress.py" --open || true
    fi
    if [[ -n "$usb" ]]; then
        msg_step "Preparing USB storage $usb"
        python3 "$SOURCE_DIR/setup_library/prepare_usb.py" --device "$usb"
        storage=mounted
    fi
    if [[ "$storage" == mounted ]]; then
        mountpoint -q /Library || { msg_error 'Mount your content disk at /Library first.'; return 1; }
    fi
    msg_step "Staging the selected Library checkout"
    # Stage only this checkout. Neither the Pi repository nor its ARM archives
    # are used, even when the checkout was launched from another directory.
    install -d -m 0755 /opt/library-creator /etc/library
    # Preserve a user-supplied /Library symlink and its filesystem permissions.
    [[ -d /Library ]] || mkdir -p /Library
    if [[ "$SOURCE_DIR" != /opt/library-creator ]]; then
        rsync -a --exclude=.git --exclude=rasbase_parts --exclude=__pycache__ \
            "$SOURCE_DIR/" /opt/library-creator/
    fi
    # ext filesystems may contain lost+found even when no content was added.
    # Seed before startup creates directories and databases on the content disk.
    if [[ -z "$(find /Library/ -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit)" ]]; then
        msg_step "Loading bundled Library content into empty storage"
        tar -xzf /opt/library-creator/setup_library/files/Library_USB.tar \
            --no-same-owner --keep-old-files -C /Library
    fi
    msg_step "Building the Debian base and application containers"
    export LIBRARY_OFFICE="$office"
    export LIBRARY_REBUILD="$rebuild"
    bash /opt/library-creator/setup_library/files/containers/build_pods.sh
    # Publish configuration only after all required images built successfully.
    python3 - "$storage" "$office" "$usb" <<'PY'
import json, os, sys
from pathlib import Path
p = Path('/etc/library/config.json')
temporary = p.with_suffix('.tmp')
temporary.write_text(json.dumps({'library_storage_mode': sys.argv[1],
                                'library_office': sys.argv[2],
                                'library_usb_device': sys.argv[3],
                                'library_storage_path': str(Path('/Library').resolve())}, indent=2) + '\n')
os.replace(temporary, p)
PY
    if [[ -n "$wifi" ]]; then
        apt-get install -y network-manager dnsmasq-base
        systemctl enable --now NetworkManager
        bash /opt/library-creator/setup_library/configure_hotspot.sh "$wifi" "$password"
    fi
    msg_step "Installing and starting Library services"
    if ! ansible-playbook -i localhost, -c local /opt/library-creator/setup_library/install_x86.yml; then
        journalctl -u start_library.service -n 100 --no-pager || true
        return 1
    fi
    msg_step "Library installation complete"
    echo 'Library installed. Open http://localhost or http://<this-machine-IP> from your browser.'
    echo 'HDMI uses the existing Debian desktop/console. No reboot is required.'
    echo 'On supported desktops, the next boot logs in as root (password: library) and opens Firefox at the Library.'
}


run_selected_action() {
    case "$action" in
        install|rebuild|restart) install_library ;;
        office) configure_office_addon ;;
        clone) install_clone_service ;;
        format)
            [[ -n "$usb" ]] || { msg_error 'Choose --usb-device PARTITION.'; return 1; }
            msg_step "USB erase confirmation for $usb"
            apt-get update
            apt-get install -y exfatprogs udev
            python3 "$SOURCE_DIR/setup_library/prepare_usb.py" --device "$usb" --format ;;
        *) return 2 ;;
    esac
}

menu() {
    local choice
    while true; do
        show_main_menu
        read -r -p "${WHITE}Select option: ${NC}" choice || return 0
        case "$choice" in
            1|3)
                storage=''; usb=''; office=''
                prompt_storage || { pause_menu; continue; }
                prompt_office_addon
                "$SOURCE_DIR/bootstrap" --install --storage "$storage" --office "$office" ${usb:+--usb-device "$usb"} || msg_error 'Installation stopped. Read the terminal/log and choose Restart Install.' ;;
            2) "$SOURCE_DIR/bootstrap" --reinstall || msg_error 'Reinstall stopped.' ;;
            4) show_status ;;
            5) "$SOURCE_DIR/bootstrap" --install-clone || msg_error 'Clone setup stopped.' ;;
            6) "$SOURCE_DIR/bootstrap" --configure-office || msg_error 'Office setup stopped.' ;;
            7) "$SOURCE_DIR/bootstrap" --rebuild || msg_error 'Rebuild stopped.' ;;
            8)
                lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS
                read -r -p 'Partition to format [/dev/sdb1]: ' usb
                "$SOURCE_DIR/bootstrap" --format-usb --usb-device "${usb:-/dev/sdb1}" || msg_warn 'Formatting stopped or cancelled.' ;;
            q|Q) return 0 ;;
            *) msg_warn 'Choose an option from the menu.' ;;
        esac
        pause_menu
    done
}

main() {
    local action=menu storage='' office='' wifi='' password='' check=no yes=no usb='' rebuild=no worker=no
    local -a original=("$@")
    while (($#)); do
        case "$1" in
            --help|-h) usage; return 0 ;;
            --check) check=yes; shift ;;
            --status) action=status; shift ;;
            --install|--fresh|--restart-install) action=install; shift ;;
            --rebuild) action=rebuild; rebuild=yes; shift ;;
            --reinstall) action=reinstall; shift ;;
            --install-clone) action=clone; shift ;;
            --format-usb) action=format; shift ;;
            --configure-office)
                action=office; shift
                if [[ "${1:-}" == yes || "${1:-}" == no ]]; then office=$1; shift; fi ;;
            --yes) yes=yes; shift ;;
            --worker) worker=yes; shift ;;
            --storage|--office|--hotspot-interface|--hotspot-password|--usb-device)
                [[ $# -ge 2 && -n "$2" ]] || { usage >&2; return 2; }
                case "$1" in
                    --storage) storage=$2 ;;
                    --office) office=$2 ;;
                    --hotspot-interface) wifi=$2 ;;
                    --hotspot-password) password=$2 ;;
                    --usb-device) usb=$2 ;;
                esac
                shift 2 ;;
            *) usage >&2; return 2 ;;
        esac
    done
    case "$storage" in ''|directory|mounted) ;; *) msg_error 'Invalid storage mode.'; return 2 ;; esac
    case "$office" in ''|yes|no) ;; *) msg_error 'Office must be yes or no.'; return 2 ;; esac
    if [[ -n "$usb" && "$storage" == directory ]]; then msg_error 'USB and directory storage conflict.'; return 2; fi
    if [[ -n "$wifi$password" ]]; then
        [[ -n "$wifi" && ${#password} -ge 8 && ${#password} -le 63 ]] || {
            msg_error 'Hotspot needs an interface and an 8–63 character WPA password.'; return 2;
        }
    fi
    # Older explicit-option commands still select installation.
    if [[ "$action" == menu && -n "$storage$office$usb$wifi" ]]; then action=install; fi
    preflight
    [[ "$check" == yes ]] && return 0
    [[ $EUID == 0 ]] || { msg_error 'Run the installer with sudo.'; return 1; }
    if [[ "$action" == status ]]; then show_status; return 0; fi
    if [[ "$action" == menu ]]; then
        [[ -t 0 ]] || { usage >&2; return 2; }
        menu
        return
    fi
    if [[ "$worker" == yes ]]; then
        [[ "${LIBRARY_INSTALL_WORKER:-}" == 1 ]] || { msg_error 'Internal worker option.'; return 2; }
        run_selected_action
        return
    fi
    exec 9>"/run/lock/library-install.lock"
    flock -n 9 || { msg_error 'Another Library operation is running.'; return 1; }
    if [[ "$action" == reinstall ]]; then
        [[ "$yes" == yes ]] || confirm 'Update this checkout with git pull --ff-only, then rebuild?' || return 0
        git -C "$SOURCE_DIR" rev-parse --is-inside-work-tree >/dev/null
        git -C "$SOURCE_DIR" pull --ff-only
        # Re-enter the updated installer; do not continue old code after pull.
        flock -u 9
        exec "$SOURCE_DIR/bootstrap" --rebuild --yes
    fi
    if [[ "$yes" != yes && "$action" != format && "$action" != office ]]; then
        banner
        msg_info "Action: $action  Source: $SOURCE_DIR"
        msg_info "USB: ${usb:-saved/existing storage}  Office: ${office:-saved/default}"
        confirm 'Continue?' || return 0
    fi
    local operation=installation
    case "$action" in office) operation='Office configuration' ;; clone) operation='Clone setup' ;; format) operation='USB formatting' ;; esac
    LIBRARY_INSTALL_WORKER=1 python3 "$SOURCE_DIR/setup_library/install_progress.py" --operation "$operation" -- \
        bash "$SOURCE_DIR/bootstrap" --worker "${original[@]}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
