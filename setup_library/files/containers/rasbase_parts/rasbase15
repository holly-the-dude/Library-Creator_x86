   EndOfQuarter()        // 2013-12-31 23:59:59.999999999 Tue
   EndOfYear()           // 2013-12-31 23:59:59.999999999 Tue
 .
   // Use another time
   t := time.Date(2013, 02, 18, 17, 51, 49, 123456789, time.UTC)
