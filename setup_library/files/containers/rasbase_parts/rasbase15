   EndOfHour()   // 2013-11-18 17:59:59.999999999 Mon
   EndOfDay()    // 2013-11-18 23:59:59.999999999 Mon
   EndOfWeek()   // 2013-11-23 23:59:59.999999999 Sat
 .
