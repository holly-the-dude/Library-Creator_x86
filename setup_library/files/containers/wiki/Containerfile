# Containerfile for the Library wiki container
# This container runs kiwix-serve to provide offline Wikipedia and other
# ZIM-format wiki content via a web interface on port 6902.

# Base image - switch between rasbase (Debian 11 bullseye) and
# rasbase_master (Debian 13 trixie) by passing --build-arg BASE_IMAGE=...
ARG BASE_IMAGE=localhost/rasbase_master:latest
FROM ${BASE_IMAGE}

# Use the native release, retaining the exact Kiwix version and theme.
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*
ARG KIWIX_VERSION=3.5.0-1
ARG KIWIX_SHA256_AMD64=da50fc74d3d134b80e0fb9c43c5ea0c2cda0681f5b41c7ba6bdeb4a03afdc57c
ARG KIWIX_SHA256_ARM64=48e50d786ab8e629867dad1e3c37494a4a01f537685c4f049e3bd6b6b61b41a1
RUN case "$(dpkg --print-architecture)" in \
        amd64) KIWIX_ARCH=x86_64; KIWIX_SHA256="$KIWIX_SHA256_AMD64" ;; \
        arm64) KIWIX_ARCH=aarch64; KIWIX_SHA256="$KIWIX_SHA256_ARM64" ;; \
        *) echo 'Unsupported Kiwix architecture' >&2; exit 1 ;; \
    esac && \
    echo "Downloading Kiwix ${KIWIX_VERSION} for ${KIWIX_ARCH}" && \
    curl -fL --retry 5 --connect-timeout 30 \
      "https://download.kiwix.org/release/kiwix-tools/kiwix-tools_linux-${KIWIX_ARCH}-${KIWIX_VERSION}.tar.gz" \
      -o /tmp/kiwix-tools.tar.gz && \
    echo "${KIWIX_SHA256}  /tmp/kiwix-tools.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/kiwix-tools.tar.gz -C /tmp && \
    cp /tmp/kiwix-tools_linux-${KIWIX_ARCH}-${KIWIX_VERSION}/kiwix-* /usr/local/bin/ && \
    chmod +x /usr/local/bin/kiwix-* && \
    /usr/local/bin/kiwix-serve --version && \
    rm -rf /tmp/kiwix-tools*

COPY build_theme.py library-theme.css /opt/library-wiki/
RUN python3 /opt/library-wiki/build_theme.py /usr/local/bin/kiwix-serve \
    /opt/library-wiki/library-theme.css /opt/library-wiki/skin
# Image-level environment also covers playbooks that invoke kiwix-serve directly.
ENV KIWIX_SERVE_CUSTOMIZED_RESOURCES=/opt/library-wiki/skin/resources.txt

# Copy the start script
COPY start_server /root/start_server
RUN chmod +x /root/start_server

# Expose kiwix-serve port
EXPOSE 6902

# Start kiwix-serve with the library XML, then keep container alive
CMD ["/bin/sh", "-c", "kiwix-serve -v -p 6902 --nodatealiases --library /wiki/wiki.xml;sleep infinity"]
