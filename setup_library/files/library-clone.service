[Unit]
Description=Clone Library USB content drives
Requires=library-clone.socket
After=library-clone.socket

[Service]
Environment=LIBRARY_CLONE_USB_ONLY=1
ExecStart=/usr/bin/python3 /usr/local/bin/library_clone.py
# Must see host mounts/devices and rootful Podman. No mount namespace:
# private /tmp or ProtectSystem would change the source being cloned.
NoNewPrivileges=true
