#!/usr/bin/python3
"""Immediately open the local startup progress page in the root desktop session."""
import os
from pathlib import Path
import shutil


def main():
    if os.getuid() != 0:
        raise SystemExit('This startup helper belongs to the root Library desktop.')
    browser = shutil.which('firefox-esr') or shutil.which('firefox')
    if not browser:
        raise SystemExit('Firefox is not installed.')
    page = Path('/run/library-startup/progress.html')
    page.parent.mkdir(parents=True, exist_ok=True)
    try:
        # Exclusive creation preserves any progress already published by Ansible.
        with page.open('x') as output:
            output.write('<!doctype html><html lang="en"><meta charset="utf-8">'
                         '<meta http-equiv="refresh" content="2">'
                         '<title>Starting your Library</title>'
                         '<body style="font:24px system-ui;background:#101a29;color:#ecf1fa;padding:40px">'
                         '<h1>Starting your Library</h1>'
                         '<p>Waiting for Ansible to start the Library services…</p></body></html>')
    except FileExistsError:
        pass
    url = page.as_uri()
    profile = Path('/root/.mozilla/firefox/library')
    profile.mkdir(parents=True, exist_ok=True)
    os.execv(browser, [browser, '--profile', str(profile), '--new-window', url])


if __name__ == '__main__':
    main()
