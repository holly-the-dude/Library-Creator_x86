#!/usr/bin/python3
"""Wait for the local Library, then open Firefox in the root desktop session."""
import os
from pathlib import Path
import shutil
import time
import urllib.error
import urllib.request


def main():
    if os.getuid() != 0:
        raise SystemExit('This startup helper belongs to the root Library desktop.')
    browser = shutil.which('firefox-esr') or shutil.which('firefox')
    if not browser:
        raise SystemExit('Firefox is not installed.')
    url = 'http://localhost/'
    deadline = time.monotonic() + 180
    client = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    while time.monotonic() < deadline:
        try:
            with client.open(url, timeout=2) as response:
                if response.status == 200:
                    break
        except (OSError, urllib.error.URLError):
            pass
        time.sleep(2)
    profile = Path('/root/.mozilla/firefox/library')
    profile.mkdir(parents=True, exist_ok=True)
    os.execv(browser, [browser, '--profile', str(profile), '--new-window', url])


if __name__ == '__main__':
    main()
