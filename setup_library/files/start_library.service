[Unit]
Description=Library content services
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/Library

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=0
ExecStart=/usr/bin/ansible-playbook -i localhost, -c local /root/start_library.yml

[Install]
WantedBy=multi-user.target
